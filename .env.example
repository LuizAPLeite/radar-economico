# Copie para .env e ajuste. O .env NÃO é versionado.

# PostgreSQL
POSTGRES_USER=radar
POSTGRES_PASSWORD=radar
POSTGRES_DB=radar
POSTGRES_PORT=5432

# URL usada pelos serviços (collector, pipeline, api, migrate)
# Dentro do Docker Compose o host é "postgres"; fora dele, "localhost".
DATABASE_URL=postgres://radar:radar@localhost:5432/radar?sslmode=disable

# Collector
SGS_START_DATE=2000-01-01
COLLECTOR_CONCURRENCY=4
# Fontes a coletar (vazio = todas): bcb_sgs,ibge,anp
COLLECTOR_SOURCES=
# Primeiro mês dos preços da ANP, AAAA-MM (vazio = 12 meses atrás).
# Cada mês são ~12 MB de CSV e o servidor da ANP é lento.
ANP_START_MONTH=

# API
API_PORT=8080

# Web (dashboard). API_URL é usada pelo servidor do Next fora do Docker;
# dentro do Compose ela é http://api:8080.
WEB_PORT=3000
API_URL=http://localhost:8080

# Pipeline: jobs a rodar (vazio = todos, sempre na ordem bcb, ibge, anp)
PIPELINE_JOBS=

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
